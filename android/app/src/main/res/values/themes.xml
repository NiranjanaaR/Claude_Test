<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.ScrollReminder" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/brand_black</item>
        <item name="android:navigationBarColor">@color/brand_black</item>
        <item name="android:windowBackground">@color/brand_black</item>
    </style>

    <!-- Translucent variant for the overlay activity so the scroll app shows faintly behind. -->
    <style name="Theme.ScrollReminder.Overlay" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
        <item name="android:statusBarColor">@color/brand_black</item>
        <item name="android:navigationBarColor">@color/brand_black</item>
    </style>

</resources>
